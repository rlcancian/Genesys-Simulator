
# GenESyS user Doxygen configuration
# Run from the repository root with:
#   doxygen docs/users/DoxyfileUser
#
# Policy:
# - Doxygen working files are generated under build/doxygen/users.
# - Intermediate HTML, LaTeX, image, index, man-page, and auxiliary files are not versioned.
# - The final PDF, when generated, should be copied to docs/users/GenESyS-User-Documentation.pdf.
# - The compatibility file DoxyfileUser2022 exists only because it was the historical entrypoint.

@INCLUDE = docs/users/DoxyfileUser2022.legacy

PROJECT_LOGO           = source/applications/gui/qt/GenesysQtGUI/resources/software_genesys.gif
OUTPUT_DIRECTORY       = build/doxygen/users
INPUT                  = source
STRIP_FROM_PATH        = source
STRIP_FROM_INC_PATH    = source

GENERATE_HTML          = NO
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES
PDF_HYPERLINKS         = YES

GENERATE_MAN           = YES
MAN_OUTPUT             = man
MAN_EXTENSION          = .3
MAN_SUBDIR             =

GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_DOCBOOK       = NO
GENERATE_HTMLHELP      = NO
GENERATE_TREEVIEW      = NO
