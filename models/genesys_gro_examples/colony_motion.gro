// GenESyS-authored fixture: simple growth and movement rules.
include gro;
set("dt", 0.1);

program main() := {
  reset(),
  ecoli([x:=-2, y:=-1], program swimmer()),
  ecoli([x:=2, y:=1], program swimmer())
};

program swimmer() := {
  speed := 0.15,
  direction := 0.25,
  grow(0.02),
  move(speed, direction)
};
