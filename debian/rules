#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_UPSTREAM_VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')

%:
	dh ${@} --buildsystem=cmake+ninja --builddirectory=build-debian

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake+ninja -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DGENESYS_BUILD_GUI_APPLICATION=ON \
		-DGENESYS_BUILD_WORKER_APPLICATION=ON \
		-DGENESYS_BUILD_TERMINAL_APPLICATION=ON \
		-DGENESYS_BUILD_LAUNCHER_APPLICATION=ON \
		-DGENESYS_BUILD_LAUNCHER_TESTS=OFF \
		-DGENESYS_BUILD_TESTS=OFF \
		-DGENESYS_ENABLE_PYTHON_INTEGRATION=OFF \
		-DGENESYS_LAUNCHER_VERSION=$(DEB_UPSTREAM_VERSION) \
		-DGENESYS_SYSTEM_PACKAGE_VERSION=$(DEB_UPSTREAM_VERSION)

override_dh_auto_build:
	cmake --build build-debian --parallel
